# ==========================================
# AHP Decision Studio - Frontend Environment Variables
# ==========================================

# URL pointing to your hosted FastAPI backend
# Example for Render: https://ahp-backend.onrender.com/api
# Example for Railway: https://ahp-backend.up.railway.app/api
# Example for Local: http://localhost:8000/api
VITE_API_BASE_URL=https://your-backend-app.onrender.com/api

# Optional: Sentry DSN for frontend error observability
VITE_SENTRY_DSN=
