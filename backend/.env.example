# ==========================================
# AHP Decision Studio - Backend Environment Variables
# ==========================================

# Allowed frontend origins for CORS (comma-separated domains or * for all)
# Example: https://ahp-frontend.vercel.app,http://localhost:5175
AHP_CORS_ORIGINS=*

# Optional: Restrict project storage modification via secret token (min 32 characters)
AHP_PROJECT_API_TOKEN=

# Optional: Sentry DSN for backend exception and performance tracking
SENTRY_DSN=

# Optional: OpenAI API Key for AI Multi-Agent Expert Panel
OPENAI_API_KEY=
